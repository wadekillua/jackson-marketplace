#!/usr/bin/env bash
# pre-commit — 提交前扫描密钥、隐私信息和危险指令
#
# 触发时机：每次 git commit 前（在本地，不依赖 GitHub）
# 检查项：
#   1. 本仓库自带扫描（scripts/scan_secrets.py）：密钥、个人隐私、危险指令
#   2. gitleaks 标准密钥扫描（已安装才跑）
#
# 紧急跳过：git commit --no-verify
# 单行误报：在该行行尾加注释 # allow-secret

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

EXIT_CODE=0

echo ""
echo "╭─ pre-commit 安全扫描 ────────────────────────────╮"
echo "│ 1/2 本仓库扫描（scripts/scan_secrets.py）        │"
echo "╰──────────────────────────────────────────────────╯"
if ! python3 scripts/scan_secrets.py --staged; then
  EXIT_CODE=1
fi

echo ""
echo "╭─ pre-commit 安全扫描 ────────────────────────────╮"
echo "│ 2/2 gitleaks（标准密钥扫描）                    │"
echo "╰──────────────────────────────────────────────────╯"
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --staged --redact --no-banner; then
    EXIT_CODE=1
  fi
else
  echo "│ ⚠️  未安装 gitleaks，跳过这一步"
  echo "│     安装：brew install gitleaks"
fi

echo ""
if [[ $EXIT_CODE -ne 0 ]]; then
  echo "✗ 提交被拦截：先处理上面的问题再 commit"
  echo "  误报处理：在该行行尾加 # allow-secret"
  echo "  紧急跳过（不推荐）：git commit --no-verify"
else
  echo "✓ 安全扫描通过"
fi

exit $EXIT_CODE
